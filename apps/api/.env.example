NODE_ENV=development
PORT=3000
API_PREFIX=api
WEB_ORIGIN=http://localhost:5173
HTTP_BODY_LIMIT=1mb

DATABASE_URL=postgresql://prisma.PROJECT_REF:replace-me@HOST:5432/postgres?sslmode=require
DIRECT_URL=postgresql://prisma:replace-me@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_SOURCE_BUCKET=source-documents

INGESTION_TOKEN=replace-with-long-random-value

HTTP_TIMEOUT_MS=12000
HTTP_MAX_BYTES=15728640
GDELT_CACHE_TTL_SECONDS=1800
LLM_PROVIDER=disabled
# Required only when LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
