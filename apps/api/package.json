{
  "name": "api",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=20.19 <21"
  },
  "scripts": {
    "prestart": "npm run build",
    "start": "node dist/main.js",
    "prestart:dev": "npm run build -w @caspian-trace/contracts -w @caspian-trace/investigation-core",
    "start:dev": "nest start --watch",
    "prebuild": "npm run build -w @caspian-trace/contracts -w @caspian-trace/investigation-core",
    "build": "nest build",
    "pretypecheck": "npm run build -w @caspian-trace/contracts -w @caspian-trace/investigation-core",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "pretest": "npm run build -w @caspian-trace/contracts -w @caspian-trace/investigation-core",
    "test": "jest --runInBand --testPathIgnorePatterns=\\.e2e-spec\\.ts$",
    "pretest:watch": "npm run build -w @caspian-trace/contracts -w @caspian-trace/investigation-core",
    "test:watch": "jest --watch --testPathIgnorePatterns=\\.e2e-spec\\.ts$",
    "pretest:e2e": "npm run build -w @caspian-trace/contracts -w @caspian-trace/investigation-core",
    "test:e2e": "jest --runInBand --testMatch=\"**/*.e2e-spec.ts\""
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/set-env.ts"
    ],
    "testMatch": [
      "**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/main.ts"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "5.9",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "@caspian-trace/contracts": "0.0.1",
    "@caspian-trace/investigation-core": "0.0.1",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "11.4.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  }
}
