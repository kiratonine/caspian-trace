# URL API бэкенда. Переменная необязательна: без .env используется фолбэк '/api'
# (см. src/constants/api.ts). В dev запросы к '/api' проксируются на NestJS
# (vite.config.ts), поэтому менять эту строку обычно не нужно.
VITE_API_BASE_URL=/api

# Источник данных: 'api' — NestJS на localhost:3000, 'seed' — проверенные данные
# из src/api/seed-data.ts без единого запроса. По умолчанию (и без .env) — 'seed':
# демо обязано работать офлайн. Переключить на 'api' после того, как поднимутся
# read-эндпоинты (контрольная точка C).
VITE_DATA_MODE=seed
