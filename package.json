{
  "name": "caspian-trace",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=20.19 <21"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run start:dev -w api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e:api": "npm run test:e2e -w api",
    "test:e2e:api-process": "npm run test:e2e:process -w api",
    "test:e2e:db": "npm run test:e2e:db -w api",
    "test:supabase:readiness": "npm run test:e2e:supabase -w api",
    "prisma:seed": "npm run prisma:seed -w api",
    "seed:validate": "npm run seed:validate -w api",
    "verify:investigation-data": "node scripts/verify-investigation-data.mjs",
    "verify:investigation-data:human": "node scripts/verify-investigation-data.mjs --require-human",
    "test:e2e:seed": "node scripts/verify-verified-seed.mjs",
    "test:seed:clean": "node scripts/verify-verified-seed.mjs",
    "test:incidents:clean": "node scripts/verify-prisma-clean-db.mjs --incidents-only",
    "test:sources:clean": "node scripts/verify-prisma-clean-db.mjs --sources-only",
    "test:supabase:storage": "node --env-file=apps/api/.env scripts/verify-supabase-storage.mjs",
    "test:safe-fetch": "npm run test:safe-fetch -w api",
    "test:kazhydromet": "npm run test:kazhydromet -w api",
    "test:kazhydromet:clean": "node scripts/verify-prisma-clean-db.mjs --kazhydromet-only",
    "pretest:kazhydromet:smoke": "npm run build -w api",
    "test:kazhydromet:smoke": "node --env-file=apps/api/.env scripts/verify-kazhydromet-ingestion.mjs",
    "test:gdelt": "npm run test:gdelt -w api",
    "test:gdelt:clean": "node scripts/verify-prisma-clean-db.mjs --gdelt-only",
    "test:investigation": "npm run test:investigation -w api",
    "test:e2e:investigation": "npm run test:e2e:investigation -w api",
    "test:investigation:clean": "node scripts/verify-prisma-clean-db.mjs --investigation-only",
    "pretest:gdelt:smoke": "npm run build -w api",
    "test:gdelt:smoke": "node --env-file=apps/api/.env scripts/verify-gdelt-ingestion.mjs",
    "pretest:safe-fetch:smoke": "npm run build -w api",
    "test:safe-fetch:smoke": "node scripts/verify-safe-fetch.mjs",
    "test:database-guard": "node --test scripts/disposable-database-guard.test.mjs",
    "prisma:format": "npm run prisma:format -w api",
    "prisma:generate": "npm run prisma:generate -w api",
    "prisma:validate": "npm run prisma:validate -w api",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy -w api",
    "prisma:migrate:status": "npm run prisma:migrate:status -w api",
    "test:prisma:clean": "node scripts/verify-prisma-clean-db.mjs",
    "test:api-clean-start": "node scripts/verify-prisma-clean-db.mjs --api-clean-start-only",
    "format": "npm run format -w web",
    "archive:backend-platform": "node scripts/create-backend-platform-archive.mjs"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.2",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
