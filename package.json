{
  "name": "caspian-trace",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=20.19 <21"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run start:dev -w api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:api-clean-start": "node scripts/verify-api-clean-start.mjs",
    "verify:investigation-data": "node scripts/verify-investigation-data.mjs",
    "generate:investigation-samples": "npm run build -w api && node scripts/generate-investigation-samples.mjs",
    "format": "npm run format -w web",
    "archive:backend-platform": "node scripts/create-backend-platform-archive.mjs"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.2",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
